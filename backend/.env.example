APP_NAME=AI Policy Service
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=127.0.0.1
PORT=8000
AUTH_REQUIRED=true
AUTH_MODE=local
# Server-only; at least 32 characters.
LOCAL_AUTH_JWT_SECRET=
LOCAL_AUTH_JWT_ISSUER=ai-policy-local
LOCAL_AUTH_JWT_AUDIENCE=aipolicy-api
LOCAL_AUTH_TOKEN_TTL_SECONDS=28800
DATABASE_URL=postgresql+psycopg://aipolicy_app:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/aipolicy_new
DATABASE_MODE=standalone
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_CORS_WILDCARD=false
ENABLE_MOCKS=false
CLASSIFIER_MODEL_PATH=
CLASSIFIER_TOKENIZER_PATH=
CLASSIFIER_LABEL_BINDINGS_PATH=
CLASSIFIER_DEPARTMENT_EMBEDDINGS_PATH=
CLASSIFIER_MODEL_VERSION=sz-tcn-bert-v1
CLASSIFIER_SUPPORTED_REGIONS=sz

# Optional local demo account password; never commit real passwords.
LOCAL_DEMO_PASSWORD=
ADMIN_USERNAME=admin_demo
