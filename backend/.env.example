APP_NAME=AI Policy Service
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=127.0.0.1
PORT=8000
AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY_SECONDS=30
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_CORS_WILDCARD=false
ENABLE_MOCKS=false
CLASSIFIER_MODEL_PATH=
CLASSIFIER_TOKENIZER_PATH=
CLASSIFIER_LABEL_BINDINGS_PATH=
CLASSIFIER_DEPARTMENT_EMBEDDINGS_PATH=
CLASSIFIER_MODEL_VERSION=sz-tcn-bert-v1
CLASSIFIER_SUPPORTED_REGIONS=sz

# B1.1 initializer mappings for four existing Supabase Auth users. These are not passwords.
IAM_DEMO_INDIVIDUAL_USER_ID=
IAM_DEMO_ENTERPRISE_USER_ID=
IAM_DEMO_GOVERNMENT_USER_ID=
IAM_DEMO_ADMIN_USER_ID=
