# Shared application settings
APP_NAME=AI Policy Service
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# json for machine-readable logs, text for local reading. Both redact credentials.
LOG_FORMAT=json
HOST=127.0.0.1
PORT=8000

# Security and standalone local authentication
AUTH_REQUIRED=true
AUTH_MODE=local
# Server-only; at least 32 characters. Never put this in frontend/.env.local.
LOCAL_AUTH_JWT_SECRET=
LOCAL_AUTH_JWT_ISSUER=ai-policy-local
LOCAL_AUTH_JWT_AUDIENCE=aipolicy-api
LOCAL_AUTH_TOKEN_TTL_SECONDS=28800
DATABASE_URL=postgresql+psycopg://aipolicy_app:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/aipolicy_new
DATABASE_MODE=standalone

# Comma-separated browser origins. Keep this explicit outside local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_CORS_WILDCARD=false

# Feature flags. Business Mock data is disabled by default and forced off in production.
ENABLE_MOCKS=false

# Optional local Shenzhen department-classifier assets. The model archive is supplied
# separately by the repository owner and is extracted under backend/models/.
CLASSIFIER_MODEL_PATH=
CLASSIFIER_TOKENIZER_PATH=
CLASSIFIER_LABEL_BINDINGS_PATH=
CLASSIFIER_DEPARTMENT_EMBEDDINGS_PATH=
CLASSIFIER_MODEL_VERSION=sz-tcn-bert-v1
# Explicit comma-separated stable region IDs; no cross-region fallback is allowed.
CLASSIFIER_SUPPORTED_REGIONS=sz

# Optional deterministic demo account settings. Never commit passwords.
LOCAL_DEMO_PASSWORD=
ADMIN_USERNAME=admin_demo
