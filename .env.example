# Shared application settings
APP_NAME=AI Policy Service
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# json for machine-readable logs, text for local reading. Both redact credentials.
LOG_FORMAT=json
HOST=127.0.0.1
PORT=8000

# Security and local development
AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY_SECONDS=30
DATABASE_URL=

# Comma-separated browser origins. Keep this explicit outside local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_CORS_WILDCARD=false

# Feature flags. Business Mock data is disabled by default and forced off in production.
ENABLE_MOCKS=false

# Future model settings. No model is loaded by the foundation change.
CLASSIFIER_MODEL_PATH=
CLASSIFIER_TOKENIZER_PATH=
CLASSIFIER_LABEL_BINDINGS_PATH=
# Explicit comma-separated stable region IDs; no cross-region fallback is allowed.
CLASSIFIER_SUPPORTED_REGIONS=sz

# B1.1 initializer mappings for existing Supabase Auth users. Never put passwords here.
IAM_DEMO_INDIVIDUAL_USER_ID=
IAM_DEMO_ENTERPRISE_USER_ID=
IAM_DEMO_GOVERNMENT_USER_ID=
IAM_DEMO_ADMIN_USER_ID=
