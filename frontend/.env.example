# Browser-facing base URL for the versioned API. Use /new-api/v1 in production
# when the site is served under /new/ on the school domain.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_BASE_PATH=/

# Authentication is handled by the FastAPI local-account API.
# Do not place database passwords, JWT secrets, or account passwords here.
